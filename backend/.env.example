APP_ENV=local
APP_NAME="Vinuni Career Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-please-use-64-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ENFORCE_RBAC=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Local development uses PostgreSQL. Use PgBouncer in production.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/vinuni_career

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WORKFLOW_BACKEND=local
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vinuni-career

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_API_STYLE=native
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE="VinUni Career Platform"
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nex-agi/nex-n2-pro:free
OPENROUTER_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_MODEL=nv-embedqa-e5-v5
NVIDIA_RERANK_MODEL=nv-rerankqa-mistral-4b-v3

SCALAR_DOCS_ENABLED=true
SCALAR_DOCS_PATH=/scalar

AI_GATEWAY_MODE=direct
# AI_GATEWAY_MODE=litellm_proxy
LITELLM_PROXY_URL=
LITELLM_API_KEY=
VISION_EXTRACTION_PROVIDER=openrouter
VISION_EXTRACTION_MODEL=gemini-3.5-flash
STRUCTURED_EXTRACTION_ENABLED=true
MAX_EXTRACTION_RETRIES=2
SEMANTIC_CACHE_ENABLED=true
GUARDRAILS_ENABLED=true
RERANK_PROVIDER=nvidia
COHERE_API_KEY=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

LLM_PROVIDER=nvidia
LLM_PROVIDER_CHAIN=nvidia,openrouter,offline
# LLM_PROVIDER_CHAIN=openrouter,openai,gemini,offline
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.35
EMBEDDING_PROVIDER_CHAIN=nvidia,openrouter,offline
# EMBEDDING_PROVIDER_CHAIN=openrouter,openai,offline
AI_DAILY_ORG_TOKEN_LIMIT=200000

CACHE_BACKEND=memory
CACHE_DEFAULT_TTL_SECONDS=300

SEARCH_BACKEND=memory
SEARCH_URL=http://localhost:9200
SEARCH_INDEX_PREFIX=vinuni
SEARCH_API_KEY=
SEARCH_USERNAME=
SEARCH_PASSWORD=

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

WEBHOOK_SHARED_SECRET=
INTERNAL_SERVICE_TOKEN=

# Optional institutional SSO. Password login remains available.
OIDC_BACKEND_CALLBACK_BASE=http://localhost:8000/api/v1/auth/oidc
OIDC_FRONTEND_CALLBACK_URL=http://localhost:3000/api/auth/oidc/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT=common

BACKEND_CORS_ORIGINS=["http://localhost:3000"]
