# Logging
LOG_LEVEL=INFO
APP_ENV=local
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_LOCALE=vi
SUPPORTED_LOCALES=vi,en
DEFAULT_COUNTRY=VN

# Local data services
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vinuni_career
REDIS_URL=redis://localhost:6379/0
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
PGVECTOR_ENABLED=true

# AI provider smoke tests
# Put real keys only in local .env, never in docs or tracked files.
OPENROUTER_API_KEY=replace-with-local-key
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL_ALIAS=chat_cheap
AI_REASONING_MODEL_ALIAS=reasoning_cheap
AI_EMBEDDING_MODEL_ALIAS=embedding_cheap
AI_EVAL_MODEL_ALIAS=eval_cheap
AI_REAL_CALLS_ENABLED=false
AI_MAX_REAL_CALLS_PER_TEST_RUN=3
AI_DAILY_COST_LIMIT_USD=1.00

# Backend Docker build/OCR profile
# Default local/dev profile is light: Tesseract + pdf2image + DeepSeek/OpenRouter structuring.
# For heavier PaddleOCR testing, set BACKEND_AI_EXTRAS=ai-production and PADDLE_OCR_ENABLED=true.
BACKEND_AI_EXTRAS=ai-lite
LOCAL_OCR_ENGINE=auto
PDF_TEXT_ENGINE=pdfplumber
DOCX_TEXT_ENGINE=python-docx
OCR_FALLBACK_ENGINE=tesseract
TESSERACT_OCR_LANGS=vie+eng
PADDLE_OCR_ENABLED=false
PADDLE_OCR_PREWARM_ENABLED=false
CV_EXTRACTION_MAX_PAGES=6
CV_EXTRACTION_MAX_SECONDS=25

# CV ingestion engine policy (docs/CV_INGESTION_EXTRACTION_SPEC.md §4).
# Each configured engine resolves to its dependency if importable, else the
# documented lightweight fallback. Engine names are INTERNAL — never user-facing.
CV_NATIVE_PDF_ENGINE=pdfplumber
CV_LAYOUT_ENGINE=none
CV_OCR_ENGINE=tesseract
CV_OCR_LANGS=vie+eng
# Vision-LLM tier: reads image / scanned-PDF CVs the local OCR path cannot parse
# (OCR + structuring in one call). Receives DOWNSCALED document images only; runs
# only when real calls are enabled and only for images/scans (text docs stay free).
CV_VISION_EXTRACTION_ENABLED=true
CV_VISION_PROVIDER_ALIAS=vision_cheap
CV_VISION_MAX_IMAGE_PX=2200
CV_VISION_MAX_PAGES=4
# LLM structuring is a TEXT-ONLY fallback, disabled by default (never raw bytes).
CV_LLM_STRUCTURING_ENABLED=false
CV_LLM_STRUCTURING_PROVIDER_ALIAS=chat_cheap
CV_INGESTION_ASYNC=true

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.dev/storage
SIGNED_URL_TTL_SECONDS=900

# Auth/session/device
JWT_SECRET_KEY=replace-with-local-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_DEVICE_LIMIT=10
ADMIN_TOTP_REQUIRED=false
ACCOUNT_LOCKOUT_FAILURES=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
GEOIP_ENABLED=false
GEOIP_CITY_LEVEL_ONLY=true
# httpOnly refresh cookie + TOTP encryption. AUTH_COOKIE_SECURE unset -> derived
# from APP_ENV (Secure off only on local http). TOTP_ENCRYPTION_KEY unset ->
# derived from JWT_SECRET_KEY for local dev; production MUST set a real Fernet
# key (urlsafe base64, 32 bytes):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AUTH_COOKIE_SECURE=true
TOTP_CHALLENGE_TTL_MINUTES=5
# TOTP_ENCRYPTION_KEY=replace-with-fernet-key
# AI_PROVIDER_KEY_ENCRYPTION_KEY=replace-with-fernet-key

# Email and notifications
# Set EMAIL_PROVIDER=smtp for real outbound mail; "local" logs to console (dev).
EMAIL_PROVIDER=local
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_TIMEOUT=30
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=career@vinuni.edu.vn
EMAIL_FROM_NAME=VinUni Career Platform
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=3
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_DIGEST_ENABLED=true
EMAIL_TEMPLATE_EDITOR_ENABLED=true

# Jobs/observability
# inline = no background loop (default, and used by tests). Set to `scheduler`
# only in the standalone `python -m app.worker` process (ADR-0003); the API never
# starts the loop.
BACKGROUND_WORKER_MODE=inline
# Outbox dead-letter threshold and scheduler base tick interval (seconds).
OUTBOX_MAX_ATTEMPTS=5
SCHEDULER_BASE_TICK_SECONDS=15
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
AUDIT_LOG_ENABLED=true
PII_LOG_REDACTION_ENABLED=true
AI_TRACE_TTL_DAYS=30
