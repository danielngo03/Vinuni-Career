# Logging
LOG_LEVEL=INFO
APP_ENV=local
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_LOCALE=vi
SUPPORTED_LOCALES=vi,en
DEFAULT_COUNTRY=VN

# Local data services
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vinuni_career
REDIS_URL=redis://localhost:6379/0
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
PGVECTOR_ENABLED=true

# AI provider smoke tests
# Put real keys only in local .env, never in docs or tracked files.
OPENROUTER_API_KEY=replace-with-local-key
AI_DEFAULT_PROVIDER=openrouter
# Concrete models bound to each function slot (admin/.env authoritative).
# Model ids are internal — never exposed to students/partners.
AI_CHAT_MODEL=deepseek/deepseek-v4-flash
AI_REASONING_MODEL=deepseek/deepseek-r1
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_RERANK_MODEL=deepseek/deepseek-v4-flash
AI_EVAL_MODEL=deepseek/deepseek-v4-flash
AI_VISION_MODEL=google/gemini-2.5-flash
# Mock Interview LIVE model — this is the model that actually powers the live
# interview conversation today (browser voice/text -> this text model on
# OpenRouter). Cheap, streamable, Vietnamese-capable. Any OpenAI-compatible model
# works; a superadmin can rebind it in the provider registry.
AI_INTERVIEW_MODEL=google/gemini-2.5-flash
# Leak-safe slot handles bound to the models above.
AI_DEFAULT_MODEL_ALIAS=chat_default
AI_REASONING_MODEL_ALIAS=reasoning_default
AI_EMBEDDING_MODEL_ALIAS=embedding_default
AI_RERANK_MODEL_ALIAS=rerank_default
AI_EVAL_MODEL_ALIAS=eval_default
AI_INTERVIEW_MODEL_ALIAS=interview_default
AI_REAL_CALLS_ENABLED=false
AI_MAX_REAL_CALLS_PER_TEST_RUN=3
AI_DAILY_COST_LIMIT_USD=1.00

# --- Mock Interview: OPTIONAL true realtime speech-to-speech tier (Tier V2) ---
# The values below DECLARE the native "live" model, but the tier stays OFF until
# you add a native provider key (AI_REALTIME_ENABLED stays false). TRUE full-duplex
# voice needs a NATIVE socket (Gemini Live over WebSocket / OpenAI Realtime over
# WebRTC) + that provider's key — it CANNOT run through OpenRouter (text-only).
# With this OFF, the live interview still works via the browser-voice tier (V1)
# driving AI_INTERVIEW_MODEL above on your OpenRouter key. To turn it on: add the
# key below, flip AI_REALTIME_ENABLED=true (superadmin).
AI_REALTIME_ENABLED=false
AI_REALTIME_PROVIDER=gemini-live
# Gemini Live native speech-to-speech model. Options (must be enabled in your
# Google project): gemini-2.5-flash-preview-native-audio-dialog (natural voice),
# gemini-3-flash-live-preview, gemini-2.5-flash-native-audio-preview-09-2025.
AI_REALTIME_MODEL=gemini-2.5-flash-preview-native-audio-dialog
AI_REALTIME_VOICE=Aoede
AI_REALTIME_TTL_SECONDS=660
# Native Google GenAI key (AI Studio developer key or Vertex express key) for
# the voice tiers: realtime Live interview + speech STT/TTS. Get it at
# aistudio.google.com or the Vertex console. Canonical var; GEMINI_API_KEY retired.
GOOGLE_API_KEY=

# --- Chat image generation (assistant generate_image tool) ---
# Native Google GenAI image model (same auth paths as the speech tier: express
# Vertex API key via GEMINI_API_KEY/GOOGLE_API_KEY, or service-account ADC via
# GOOGLE_APPLICATION_CREDENTIALS). RBAC-gated + metered; model id is internal
# and never shown to end users. Keep disabled unless a Google key is configured.
AI_IMAGE_ENABLED=false
AI_IMAGE_USE_VERTEX=true
AI_IMAGE_MODEL=gemini-2.5-flash-image
AI_IMAGE_MODEL_ALIAS=image_default
AI_IMAGE_MAX_PX=1024

# Backend Docker build/OCR profile
# Default local/dev profile is light: Tesseract + pdf2image + DeepSeek/OpenRouter structuring.
# For heavier PaddleOCR testing, set BACKEND_AI_EXTRAS=ai-production and PADDLE_OCR_ENABLED=true.
BACKEND_AI_EXTRAS=ai-lite
LOCAL_OCR_ENGINE=auto
PDF_TEXT_ENGINE=pdfplumber
DOCX_TEXT_ENGINE=python-docx
OCR_FALLBACK_ENGINE=tesseract
TESSERACT_OCR_LANGS=vie+eng
PADDLE_OCR_ENABLED=false
PADDLE_OCR_PREWARM_ENABLED=false
CV_EXTRACTION_MAX_PAGES=6
CV_EXTRACTION_MAX_SECONDS=25

# CV ingestion engine policy (docs/CV_INGESTION_EXTRACTION_SPEC.md §4).
# Each configured engine resolves to its dependency if importable, else the
# documented lightweight fallback. Engine names are INTERNAL — never user-facing.
CV_NATIVE_PDF_ENGINE=pdfplumber
CV_LAYOUT_ENGINE=none
CV_OCR_ENGINE=tesseract
CV_OCR_LANGS=vie+eng
# Vision-LLM tier: reads image / scanned-PDF CVs the local OCR path cannot parse
# (OCR + structuring in one call). Receives DOWNSCALED document images only; runs
# only when real calls are enabled and only for images/scans (text docs stay free).
CV_VISION_EXTRACTION_ENABLED=true
CV_VISION_PROVIDER_ALIAS=vision_default
CV_VISION_MAX_IMAGE_PX=2200
CV_VISION_MAX_PAGES=4
# LLM structuring is a TEXT-ONLY fallback, disabled by default (never raw bytes).
CV_LLM_STRUCTURING_ENABLED=false
CV_LLM_STRUCTURING_PROVIDER_ALIAS=chat_default
CV_INGESTION_ASYNC=true

# Partner JD (job-description) upload extraction — same cost-tiered cascade as CV
# (native text -> vision-LLM for images/scans -> OCR -> text-LLM structuring).
# Model selection uses the admin-managed *_default slots, NOT legacy *_cheap aliases.
JD_VISION_EXTRACTION_ENABLED=true
JD_VISION_PROVIDER_ALIAS=vision_default
JD_VISION_MAX_IMAGE_PX=2200
JD_VISION_MAX_PAGES=3
JD_LLM_STRUCTURING_PROVIDER_ALIAS=chat_default

# Storage
# local = files under LOCAL_STORAGE_DIR (dev). gcs = Google Cloud Storage bucket
# (production/Cloud Run — the container filesystem is ephemeral, so uploads
# would be lost on restart with `local`).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.dev/storage
# Required when STORAGE_BACKEND=gcs. Credentials come from Application Default
# Credentials (Cloud Run service account, or `gcloud auth application-default login`).
# GCS_BUCKET_NAME=vinuni-career-media
# GCS_KEY_PREFIX=
SIGNED_URL_TTL_SECONDS=900

# Auth/session/device
JWT_SECRET_KEY=replace-with-local-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_DEVICE_LIMIT=10
ADMIN_TOTP_REQUIRED=false
ACCOUNT_LOCKOUT_FAILURES=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
GEOIP_ENABLED=false
GEOIP_CITY_LEVEL_ONLY=true
# httpOnly refresh cookie + TOTP encryption. AUTH_COOKIE_SECURE unset -> derived
# from APP_ENV (Secure off only on local http). TOTP_ENCRYPTION_KEY unset ->
# derived from JWT_SECRET_KEY for local dev; production MUST set a real Fernet
# key (urlsafe base64, 32 bytes):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AUTH_COOKIE_SECURE=true
TOTP_CHALLENGE_TTL_MINUTES=5
# TOTP_ENCRYPTION_KEY=replace-with-fernet-key
# Provider API-key encryption (Fernet). Comma-separated, NEWEST KEY FIRST — this
# enables zero-downtime rotation (Phase 2). Required in production; local dev
# derives a key from JWT_SECRET_KEY with a warning if unset.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_PROVIDER_KEY_ENCRYPTION_KEYS=

# Email and notifications
# Set EMAIL_PROVIDER=smtp for real outbound mail; "local" logs to console (dev).
EMAIL_PROVIDER=local
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_TIMEOUT=30
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=career@vinuni.edu.vn
EMAIL_FROM_NAME=VinUni Career Platform
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=3
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_DIGEST_ENABLED=true
EMAIL_TEMPLATE_EDITOR_ENABLED=true

# Jobs/observability
# inline = no background loop (default, and used by tests). Set to `scheduler`
# only in the standalone `python -m app.worker` process (ADR-0003); the API never
# starts the loop.
BACKGROUND_WORKER_MODE=inline
# Outbox dead-letter threshold and scheduler base tick interval (seconds).
OUTBOX_MAX_ATTEMPTS=5
SCHEDULER_BASE_TICK_SECONDS=15
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
AUDIT_LOG_ENABLED=true
PII_LOG_REDACTION_ENABLED=true
AI_TRACE_TTL_DAYS=30

# Production deploy (Cloud Run) — see docs/DEPLOYMENT_GCP.md
# Comma-separated browser origins allowed to call the API with credentials.
# With the same-origin Next.js proxy this is just the public site origin.
# CORS_ALLOW_ORIGINS=https://career.example.com
# Required when APP_ENV != local (startup fails without them):
# AI_PROVIDER_KEY_ENCRYPTION_KEYS=<fernet-key, e.g. `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`>
# TOTP_ENCRYPTION_KEY=<fernet-key>

# Google OAuth (Sign in with Google) — register in Google Cloud Console:
# APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: <public-origin>/api/v1/auth/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# Public origin the OAuth callback is served from (defaults to APP_URL).
# With the same-origin proxy this is the frontend's public origin.
# OAUTH_REDIRECT_BASE_URL=https://career.example.com
