APP_ENV=local
APP_NAME="C2 Career Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-please-use-64-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ENFORCE_RBAC=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Local MVP can use sqlite:///./local.db. Production should use PostgreSQL via PgBouncer.
DATABASE_URL=sqlite:///./local.db
# DATABASE_URL=postgresql+psycopg://app:app@localhost:55432/c2_app

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_API_STYLE=native
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3:14b
LOCAL_EMBEDDING_MODEL=nomic-embed-text-v2-moe

SCALAR_DOCS_ENABLED=true
SCALAR_DOCS_PATH=/scalar

LLM_PROVIDER=offline
LLM_PROVIDER_CHAIN=offline
# LLM_PROVIDER_CHAIN=openai,gemini,local,offline
LLM_MODEL=gpt-5.4-nano
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
EMBEDDING_PROVIDER_CHAIN=offline
# EMBEDDING_PROVIDER_CHAIN=openai,local,offline
AI_DAILY_ORG_TOKEN_LIMIT=200000

CACHE_BACKEND=memory
CACHE_DEFAULT_TTL_SECONDS=300

SEARCH_BACKEND=memory
SEARCH_URL=http://localhost:9200
SEARCH_INDEX_PREFIX=c2
SEARCH_API_KEY=
SEARCH_USERNAME=
SEARCH_PASSWORD=

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

WEBHOOK_SHARED_SECRET=

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
