{"id": "chat_happy_benign_search", "input": {"message": "Tìm giúp mình việc làm data analyst ở Hà Nội", "tool_class": "read_only"}, "expect": {"policy_action": "allow", "clean_text_is_none": false}}
{"id": "chat_happy_search_jobs_valid", "input": {"tool_name": "search_jobs", "tool_args": {"q": "data analyst"}}, "expect": {"validation_ok": true, "permission_class": "read_only", "requires_confirmation": false}}
{"id": "chat_happy_apply_job_valid", "input": {"tool_name": "apply_job", "tool_args": {"job_id": "11111111-1111-1111-1111-111111111111"}}, "expect": {"validation_ok": true, "permission_class": "confirmation_required", "requires_confirmation": true}}
{"id": "chat_happy_save_job_valid", "input": {"tool_name": "save_job", "tool_args": {"job_id": "22222222-2222-2222-2222-222222222222"}}, "expect": {"validation_ok": true, "permission_class": "confirmation_required", "requires_confirmation": true}}
{"id": "chat_happy_parse_tool_call", "input": {"raw_llm_output": "{\"tool_call\": {\"name\": \"search_jobs\", \"args\": {\"q\": \"backend engineer\"}}}"}, "expect": {"parsed_tool_call_name": "search_jobs", "parsed_tool_exists_for_parsed": true}}
{"id": "chat_happy_normalize_role_arg", "input": {"raw_llm_output": "{\"tool_call\": {\"name\": \"get_career_advice\", \"args\": {\"job_title\": \"product manager\"}}}"}, "expect": {"parsed_tool_call_name": "get_career_advice", "parsed_role_arg": "product manager"}}
{"id": "chat_happy_greeting_fast_path", "input": {"message": "Xin chào"}, "expect": {"fast_path_reply_is_none": false, "policy_action": "allow"}}
{"id": "chat_happy_external_source_refused", "input": {"message": "Can you search LinkedIn job recommendations for me?"}, "expect": {"policy_action": "refuse", "policy_flag_contains": "external_source_request", "refusal_message_present": true}}
{"id": "chat_happy_salary_benchmark_valid", "input": {"tool_name": "get_salary_benchmark", "tool_args": {"role": "software engineer", "city": "hanoi", "experience_years": 2}}, "expect": {"validation_ok": true, "permission_class": "read_only"}}
{"id": "chat_happy_upcoming_events_valid_no_args", "input": {"tool_name": "get_upcoming_events", "tool_args": {}}, "expect": {"validation_ok": true, "permission_class": "read_only", "requires_confirmation": false}}
{"id": "chat_happy_knowledge_base_query_valid", "input": {"tool_name": "knowledge_base_query", "tool_args": {"query": "internship visa policy"}}, "expect": {"validation_ok": true, "permission_class": "read_only"}}
