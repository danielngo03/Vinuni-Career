{"id": "cs_lowq_zero_applications", "input": {"total_applications": 0, "active_applications": 0, "interviews_upcoming": 0, "llm_note": "You haven't applied to any positions yet. Consider exploring roles that fit your interests."}, "expect": {"is_fallback": false, "snapshot_nonempty": true}}
{"id": "cs_lowq_missing_headline", "input": {"total_applications": 1, "active_applications": 1, "interviews_upcoming": 0, "headline": "", "llm_note": "You have 1 active application in progress."}, "expect": {"is_fallback": false, "no_crash": true}}
{"id": "cs_lowq_no_interviews_field_defaults_zero", "input": {"total_applications": 2, "active_applications": 1, "llm_note": "You have 2 applications sent, 1 still active."}, "expect": {"is_fallback": false, "no_crash": true}}
{"id": "cs_lowq_whitespace_only_note_treated_as_empty", "input": {"total_applications": 1, "active_applications": 1, "interviews_upcoming": 0, "llm_note": "   "}, "expect": {"no_crash": true}}
{"id": "cs_lowq_total_less_than_active_mismatch_no_crash", "input": {"total_applications": 1, "active_applications": 5, "interviews_upcoming": 0, "llm_note": "You have 1 application sent, still counted as active."}, "expect": {"no_crash": true, "is_fallback": false}}
