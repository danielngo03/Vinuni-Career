{"id": "cs_priv_note_with_phone_not_leaked_when_absent", "input": {"total_applications": 2, "active_applications": 1, "interviews_upcoming": 0, "llm_note": "You have 2 applications sent, 1 still active."}, "expect": {"blob_excludes": "0912345678"}}
{"id": "cs_priv_note_with_email_stripped_by_no_pii_check", "input": {"total_applications": 2, "active_applications": 1, "interviews_upcoming": 0, "llm_note": "You have 2 applications sent, 1 still active."}, "expect": {"no_pii_in_response": true}}
{"id": "cs_priv_fallback_path_is_generic_no_pii", "input": {"total_applications": 2, "active_applications": 1, "interviews_upcoming": 0, "provider": "unavailable"}, "expect": {"is_fallback": true, "no_pii_in_response": true}}
{"id": "cs_priv_no_provider_model_leak", "input": {"total_applications": 3, "active_applications": 2, "interviews_upcoming": 1, "llm_note": "You have 3 applications sent, 2 still active, and 1 upcoming interview."}, "expect": {"no_provider_leak": true, "no_model_leak": true}}
{"id": "cs_priv_no_internal_status_leak", "input": {"total_applications": 3, "active_applications": 2, "interviews_upcoming": 1, "llm_note": "You have 3 applications sent, 2 still active, and 1 upcoming interview."}, "expect": {"no_internal_status_codes": true}}
{"id": "cs_priv_headline_does_not_leak_company_names", "input": {"total_applications": 1, "active_applications": 1, "interviews_upcoming": 0, "headline": "Intern at ExampleCorp", "llm_note": "You have 1 active application in progress."}, "expect": {"no_pii_in_response": true}}
