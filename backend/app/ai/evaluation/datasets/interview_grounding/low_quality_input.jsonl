{"id": "lg_empty_job", "note": "empty job -> behavioral + intermediate defaults, low_signal flagged", "input": {"job": {}}, "expect": {"focus_equals": "behavioral", "difficulty_equals": "intermediate", "low_signal": true, "requirements_count_at_most": 0, "no_provider_leak": true}}
{"id": "lg_only_title", "note": "title only, no requirements/skills/description -> low_signal", "input": {"job": {"title": "Assistant"}}, "expect": {"focus_equals": "behavioral", "difficulty_equals": "intermediate", "low_signal": true, "requirements_count_at_most": 0}}
{"id": "lg_thin_description_no_reqs", "note": "a tiny description with no requirements/skills stays low_signal", "input": {"job": {"title": "Coordinator", "description": "Help the team."}}, "expect": {"focus_equals": "behavioral", "low_signal": true, "requirements_count_at_most": 0}}
{"id": "lg_reqs_but_no_skills", "note": "requirements present -> NOT low_signal even with no listed skills", "input": {"job": {"title": "Coordinator", "requirements": "Coordinate events and manage logistics"}}, "expect": {"focus_equals": "behavioral", "low_signal": false, "requirements_count_at_least": 1}}
{"id": "lg_garbled_requirements", "note": "garbled requirement lines are filtered out -> no usable bullets, low_signal", "input": {"job": {"title": "Coordinator", "requirements": "aaaa\nbb\n!!!\nxx"}}, "expect": {"focus_equals": "behavioral", "low_signal": true, "requirements_count_at_most": 0}}
{"id": "lg_whitespace_fields", "note": "whitespace-only fields collapse to empty -> safe deterministic defaults, low_signal", "input": {"job": {"title": "   ", "requirements": "   ", "description": "   "}}, "expect": {"focus_equals": "behavioral", "difficulty_equals": "intermediate", "low_signal": true, "requirements_count_at_most": 0}}
