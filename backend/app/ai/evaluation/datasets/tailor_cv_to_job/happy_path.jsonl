{"id": "tailor_hp_reorder_skills_first", "input": {"instruction": "Tailor my CV for a technical role by putting skills before education", "cv_sections": [{"section_type": "skills", "content": {"items": [{"text": "python"}]}}, {"section_type": "education", "content": {"items": [{"text": "VinUniversity"}]}}], "model_response": {"operations": [{"op": "reorder_sections", "order": ["skills", "education"]}], "explanation": "Moved skills above education."}}, "expect": {"applicable": true, "requires_fact_confirmation": true}}
