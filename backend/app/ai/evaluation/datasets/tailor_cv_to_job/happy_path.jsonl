{"id": "tailor_hp_summary_data_analyst", "input": {"instruction": "Tailor my summary for the 'Data Analyst' role", "cv_sections": [{"section_type": "summary", "content": {"items": [{"text": "junior dev"}]}}], "model_response": {"operations": [{"op": "update_item_text", "section_type": "summary", "item_index": 0, "text": "Aspiring data analyst with a background in software development."}], "explanation": "Rewrote the summary for the data analyst role."}}, "expect": {"applicable": true, "requires_fact_confirmation": true, "after_contains": "data analyst"}}
{"id": "tailor_hp_add_payments_bullet", "input": {"instruction": "Tailor my CV for a backend role by strengthening my payments work", "raw_notes": "shipped the payments feature for 10k users", "cv_sections": [{"section_type": "experience", "content": {"items": [{"text": "worked on backend"}]}}], "model_response": {"operations": [{"op": "add_item_text", "section_type": "experience", "text": "Shipped the payments feature for 10k users."}], "explanation": "Added a bullet about the payments feature."}}, "expect": {"applicable": true, "requires_fact_confirmation": true, "after_bullet_count": 2}}
{"id": "tailor_hp_reorder_projects_internship", "input": {"instruction": "Tailor my CV for this internship by moving projects above experience", "cv_sections": [{"section_type": "projects", "content": {"items": [{"text": "built a chatbot"}]}}, {"section_type": "experience", "content": {"items": [{"text": "worked somewhere"}]}}], "model_response": {"operations": [{"op": "reorder_sections", "order": ["projects", "experience"]}], "explanation": "Moved projects above experience."}}, "expect": {"applicable": true, "requires_fact_confirmation": true}}
{"id": "tailor_hp_tighten_skills", "input": {"instruction": "Tailor my skills wording for a frontend role", "cv_sections": [{"section_type": "skills", "content": {"items": [{"text": "python, sql, some react"}]}}], "model_response": {"operations": [{"op": "update_item_text", "section_type": "skills", "item_index": 0, "text": "Python, SQL, React"}], "explanation": "Tightened the skills wording."}}, "expect": {"applicable": true, "requires_fact_confirmation": true, "after_contains": "react"}}
{"id": "tailor_hp_add_project_bullet", "input": {"instruction": "Tailor my CV for an ML role by adding the chatbot project", "raw_notes": "built a chatbot with rasa and deployed it on telegram", "cv_sections": [{"section_type": "projects", "content": {"items": []}}], "model_response": {"operations": [{"op": "add_item_text", "section_type": "projects", "text": "Built a chatbot with Rasa and deployed it on Telegram."}], "explanation": "Added a project bullet."}}, "expect": {"applicable": true, "requires_fact_confirmation": true, "after_bullet_count": 1}}
{"id": "tailor_hp_fix_education_typo", "input": {"instruction": "Tailor my CV for this job and fix the typo in my education entry", "cv_sections": [{"section_type": "education", "content": {"items": [{"text": "VinUnivercity, BSc Computer Science"}]}}], "model_response": {"operations": [{"op": "update_item_text", "section_type": "education", "item_index": 0, "text": "VinUniversity, BSc Computer Science"}], "explanation": "Fixed the spelling of VinUniversity."}}, "expect": {"applicable": true, "requires_fact_confirmation": true, "after_contains": "vinuniversity"}}
