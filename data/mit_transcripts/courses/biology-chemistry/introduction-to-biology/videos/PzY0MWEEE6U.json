      "end": 10.56,
      "duration": 3.65,
      "text": "offer high quality educational resources for free."
    },
    {
      "index": 4,
      "start": 10.56,
      "end": 13.46,
      "duration": 2.9,
      "text": "To make a donation or view additional materials from"
    },
    {
      "index": 5,
