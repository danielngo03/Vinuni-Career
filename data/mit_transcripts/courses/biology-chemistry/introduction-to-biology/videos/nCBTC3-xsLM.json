{
  "video": {
    "id": "nCBTC3-xsLM",
    "title": "Covalent Bonds | MIT 7.01SC Fundamentals of Biology",
    "url": "https://www.youtube.com/watch?v=nCBTC3-xsLM",
    "channel": "MIT OpenCourseWare",
    "duration": 351,
