{
  "video": {
    "id": "zQfcPQpKZUk",
    "title": "cDNA Libraries and Expression Libraries | MIT 7.01SC Fundamentals of Biology",
    "url": "https://www.youtube.com/watch?v=zQfcPQpKZUk",
    "channel": "MIT OpenCourseWare",
    "duration": 811,
    "language": "en"
  },
  "segment_count": 298,
  "segments": [
    {
      "index": 0,
      "start": 6.318,
      "end": 7.29,
      "duration": 0.972,
      "text": "ERIC LANDER: That worked."
    },
    {
      "index": 1,
      "start": 7.29,
      "end": 8.8,
      "duration": 1.51,
      "text": "Let's do it again."
    },
    {
      "index": 2,
      "start": 8.8,
      "end": 13.97,
      "duration": 5.17,
      "text": "Now, number 2."
    },
    {
      "index": 3,
      "start": 13.97,
      "end": 19.79,
      "duration": 5.82,
      "text": "I would like to clone not the Arg1 gene, but let's say the"
    },
    {
      "index": 4,
      "start": 19.79,
      "end": 23.02,
      "duration": 3.23,
      "text": "beta globin gene from human."
    },
    {
      "index": 5,
      "start": 23.02,
      "end": 26.29,
      "duration": 3.27,
      "text": "So let's take human beta globin."
    },
    {
      "index": 6,
      "start": 31.71,
      "end": 33.07,
      "duration": 1.36,
      "text": "I want to clone it."
    },
    {
      "index": 7,
      "start": 33.07,
      "end": 37.81,
      "duration": 4.74,
      "text": "So human beta globin, hemoglobin, it's a tetromer."
    },
    {
      "index": 8,
      "start": 37.81,
      "end": 39.53,
      "duration": 1.72,
      "text": "It has four parts."
    },
    {
      "index": 9,
      "start": 39.53,
      "end": 42.07,
      "duration": 2.54,
      "text": "It's got an alpha, an alpha, a beta, and a beta."
    },
    {
      "index": 10,
      "start": 42.07,
      "end": 44.93,
      "duration": 2.86,
      "text": "Four proteins come together in a protein tetromer."
    },
    {
      "index": 11,
      "start": 44.93,
      "end": 46.88,
      "duration": 1.95,
      "text": "And it's got two alphas, two betas."
    },
    {
      "index": 12,
      "start": 46.88,
      "end": 52.52,
      "duration": 5.64,
      "text": "The beta subunit of hemoglobin is encoded by the human beta"
    },
    {
      "index": 13,
      "start": 52.52,
      "end": 53.82,
      "duration": 1.3,
      "text": "globin gene."
    },
    {
      "index": 14,
      "start": 53.82,
      "end": 55.245,
      "duration": 1.425,
      "text": "That's the nomenclature here."
    },
    {
      "index": 15,
      "start": 55.245,
      "end": 56.87,
      "duration": 1.625,
      "text": "All right."
    },
    {
      "index": 16,
      "start": 56.87,
      "end": 58.12,
      "duration": 1.25,
      "text": "Let's clone beta globin."
    },
    {
      "index": 17,
      "start": 61.15,
      "end": 61.67,
      "duration": 0.52,
      "text": "Same deal."
    },
    {
      "index": 18,
      "start": 61.67,
      "end": 64.709,
      "duration": 3.039,
      "text": "How are we going to do it?"
    },
    {
      "index": 19,
      "start": 64.709,
      "end": 65.959,
      "duration": 1.25,
      "text": "Any takers?"
    },
    {
      "index": 20,
      "start": 69.12,
      "end": 69.8,
      "duration": 0.68,
      "text": "What should we start with?"
    },
    {
      "index": 21,
      "start": 69.8,
      "end": 70.21,
      "duration": 0.41,
      "text": "Yes?"
    },
    {
      "index": 22,
      "start": 70.21,
      "end": 72.436,
      "duration": 2.226,
      "text": "AUDIENCE: Find a restriction enzyme?"
    },
    {
      "index": 23,
      "start": 72.436,
      "end": 74.08,
      "duration": 1.644,
      "text": "ERIC LANDER: Find a restriction enzyme."
    },
    {
      "index": 24,
      "start": 74.08,
      "end": 76.89,
      "duration": 2.81,
      "text": "I'll go to catalogue and try EcoRI today."
    },
    {
      "index": 25,
      "start": 76.89,
      "end": 77.8,
      "duration": 0.91,
      "text": "OK?"
    },
    {
      "index": 26,
      "start": 77.8,
      "end": 80.158,
      "duration": 2.358,
      "text": "Now what?"
    },
    {
      "index": 27,
      "start": 80.158,
      "end": 85.078,
      "duration": 4.92,
      "text": "AUDIENCE: Add it to a bunch of [INAUDIBLE]."
    },
    {
      "index": 28,
      "start": 85.078,
      "end": 86.74,
      "duration": 1.662,
      "text": "ERIC LANDER: So I'm going to start with human DNA?"
    },
    {
      "index": 29,
      "start": 86.74,
      "end": 88.945,
      "duration": 2.205,
      "text": "AUDIENCE: Yes."
    },
    {
      "index": 30,
      "start": 88.945,
      "end": 91.38,
      "duration": 2.435,
      "text": "ERIC LANDER: Yes is a good answer."
    },
    {
      "index": 31,
      "start": 91.38,
      "end": 92.05,
      "duration": 0.67,
      "text": "Yes."
    },
    {
      "index": 32,
      "start": 92.05,
      "end": 93.99,
      "duration": 1.94,
      "text": "I'm going to start with human DNA."
    },
    {
      "index": 33,
      "start": 93.99,
      "end": 94.37,
      "duration": 0.38,
      "text": "Good."
    },
    {
      "index": 34,
      "start": 94.37,
      "end": 95.16,
      "duration": 0.79,
      "text": "Let's get that up there."
    },
    {
      "index": 35,
      "start": 95.16,
      "end": 95.78,
      "duration": 0.62,
      "text": "We're going to start--"
    },
    {
      "index": 36,
      "start": 95.78,
      "end": 96.29,
      "duration": 0.51,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 37,
      "start": 96.29,
      "end": 96.745,
      "duration": 0.455,
      "text": "ERIC LANDER: Sorry?"
    },
    {
      "index": 38,
      "start": 96.745,
      "end": 98.58,
      "duration": 1.835,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 39,
      "start": 98.58,
      "end": 100.12,
      "duration": 1.54,
      "text": "ERIC LANDER: So we'll start with human DNA."
    },
    {
      "index": 40,
      "start": 104.08,
      "end": 109.43,
      "duration": 5.35,
      "text": "There we go, pieces of human DNA cut with EcoRI."
    },
    {
      "index": 41,
      "start": 109.43,
      "end": 110.68,
      "duration": 1.25,
      "text": "Now, what are we going to do?"
    },
    {
      "index": 42,
      "start": 113.83,
      "end": 115.59,
      "duration": 1.76,
      "text": "Takers?"
    },
    {
      "index": 43,
      "start": 115.59,
      "end": 117.59,
      "duration": 2.0,
      "text": "Let's attach it to a vector."
    },
    {
      "index": 44,
      "start": 117.59,
      "end": 121.56,
      "duration": 3.97,
      "text": "Actually, wait a second."
    },
    {
      "index": 45,
      "start": 121.56,
      "end": 126.33,
      "duration": 4.77,
      "text": "This vector here, I told you that there were vectors that"
    },
    {
      "index": 46,
      "start": 126.33,
      "end": 127.707,
      "duration": 1.377,
      "text": "could grow in E. coli."
    },
    {
      "index": 47,
      "start": 127.707,
      "end": 128.93,
      "duration": 1.223,
      "text": "Did I ever tell you there were vectors that"
    },
    {
      "index": 48,
      "start": 128.93,
      "end": 130.18,
      "duration": 1.25,
      "text": "could grow a yeast?"
    },
    {
      "index": 49,
      "start": 132.88,
      "end": 135.8,
      "duration": 2.92,
      "text": "There are."
    },
    {
      "index": 50,
      "start": 135.8,
      "end": 136.72,
      "duration": 0.92,
      "text": "And they're in the catalog."
    },
    {
      "index": 51,
      "start": 136.72,
      "end": 137.53,
      "duration": 0.81,
      "text": "OK."
    },
    {
      "index": 52,
      "start": 137.53,
      "end": 139.0,
      "duration": 1.47,
      "text": "Yes?"
    },
    {
      "index": 53,
      "start": 139.0,
      "end": 139.65,
      "duration": 0.65,
      "text": "Now, what am I going to do?"
    },
    {
      "index": 54,
      "start": 139.65,
      "end": 140.98,
      "duration": 1.33,
      "text": "I'm going to attach this to a vector."
    },
    {
      "index": 55,
      "start": 144.98,
      "end": 146.9,
      "duration": 1.92,
      "text": "Now, what do I do?"
    },
    {
      "index": 56,
      "start": 146.9,
      "end": 148.49,
      "duration": 1.59,
      "text": "What vector do I want to attach this to?"
    },
    {
      "index": 57,
      "start": 151.54,
      "end": 154.49,
      "duration": 2.95,
      "text": "Where is it going to grow?"
    },
    {
      "index": 58,
      "start": 154.49,
      "end": 155.74,
      "duration": 1.25,
      "text": "Human cells."
    },
    {
      "index": 59,
      "start": 158.96,
      "end": 160.55,
      "duration": 1.59,
      "text": "That's interesting."
    },
    {
      "index": 60,
      "start": 160.55,
      "end": 162.365,
      "duration": 1.815,
      "text": "So one option would be human cells."
    },
    {
      "index": 61,
      "start": 162.365,
      "end": 167.34,
      "duration": 4.975,
      "text": "So we want to take a vector that grows in human cells."
    },
    {
      "index": 62,
      "start": 167.34,
      "end": 168.59,
      "duration": 1.25,
      "text": "Ha."
    },
    {
      "index": 63,
      "start": 172.88,
      "end": 173.373,
      "duration": 0.493,
      "text": "Yep."
    },
    {
      "index": 64,
      "start": 173.373,
      "end": 174.623,
      "duration": 1.25,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 65,
      "start": 179.79,
      "end": 181.79,
      "duration": 2.0,
      "text": "ERIC LANDER: Then I need a mammalian origin of"
    },
    {
      "index": 66,
      "start": 181.79,
      "end": 182.73,
      "duration": 0.94,
      "text": "replication."
    },
    {
      "index": 67,
      "start": 182.73,
      "end": 185.11,
      "duration": 2.38,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 68,
      "start": 185.11,
      "end": 186.52,
      "duration": 1.41,
      "text": "ERIC LANDER: And a mammal--"
    },
    {
      "index": 69,
      "start": 186.52,
      "end": 190.38,
      "duration": 3.86,
      "text": "Well, so it turns out that I can technically do this."
    },
    {
      "index": 70,
      "start": 190.38,
      "end": 192.61,
      "duration": 2.23,
      "text": "There are now vectors that I can use to"
    },
    {
      "index": 71,
      "start": 192.61,
      "end": 195.34,
      "duration": 2.73,
      "text": "grow in human cells."
    },
    {
      "index": 72,
      "start": 195.34,
      "end": 197.82,
      "duration": 2.48,
      "text": "It's a lot harder to do."
    },
    {
      "index": 73,
      "start": 197.82,
      "end": 202.68,
      "duration": 4.86,
      "text": "So let's try doing it with a microbe first, but then we'll"
    },
    {
      "index": 74,
      "start": 202.68,
      "end": 204.95,
      "duration": 2.27,
      "text": "come back and we'll do it with human."
    },
    {
      "index": 75,
      "start": 204.95,
      "end": 206.22,
      "duration": 1.27,
      "text": "So try doing this in a microbe."
    },
    {
      "index": 76,
      "start": 206.22,
      "end": 208.05,
      "duration": 1.83,
      "text": "What have you got for a microbe?"
    },
    {
      "index": 77,
      "start": 208.05,
      "end": 209.3,
      "duration": 1.25,
      "text": "How do we do this in a microbe?"
    },
    {
      "index": 78,
      "start": 215.3,
      "end": 218.71,
      "duration": 3.41,
      "text": "Well, let's try E. coli for the sake of argument."
    },
    {
      "index": 79,
      "start": 218.71,
      "end": 222.48,
      "duration": 3.77,
      "text": "But we could also try, keep in mind your human for a second."
    },
    {
      "index": 80,
      "start": 222.48,
      "end": 225.45,
      "duration": 2.97,
      "text": "We do this, we do this, we get a plate."
    },
    {
      "index": 81,
      "start": 225.45,
      "end": 229.07,
      "duration": 3.62,
      "text": "One of these guys is going to have alpha globin, one of them"
    },
    {
      "index": 82,
      "start": 229.07,
      "end": 230.5,
      "duration": 1.43,
      "text": "will have collagen."
    },
    {
      "index": 83,
      "start": 230.5,
      "end": 232.91,
      "duration": 2.41,
      "text": "That guy here has beta globin."
    },
    {
      "index": 84,
      "start": 232.91,
      "end": 235.77,
      "duration": 2.86,
      "text": "How are we going to recognize it?"
    },
    {
      "index": 85,
      "start": 235.77,
      "end": 237.02,
      "duration": 1.25,
      "text": "This is tough."
    },
    {
      "index": 86,
      "start": 239.4,
      "end": 240.49,
      "duration": 1.09,
      "text": "What were you going to do for the human?"
    },
    {
      "index": 87,
      "start": 240.49,
      "end": 242.194,
      "duration": 1.704,
      "text": "AUDIENCE: No idea."
    },
    {
      "index": 88,
      "start": 242.194,
      "end": 243.405,
      "duration": 1.211,
      "text": "ERIC LANDER: But you were going to get it"
    },
    {
      "index": 89,
      "start": 243.405,
      "end": 244.39,
      "duration": 0.985,
      "text": "into a human cell."
    },
    {
      "index": 90,
      "start": 244.39,
      "end": 244.89,
      "duration": 0.5,
      "text": "AUDIENCE: Yeah."
    },
    {
      "index": 91,
      "start": 244.89,
      "end": 246.68,
      "duration": 1.79,
      "text": "ERIC LANDER: Were you going to try to do complementation?"
    },
    {
      "index": 92,
      "start": 246.68,
      "end": 247.886,
      "duration": 1.206,
      "text": "AUDIENCE: Maybe."
    },
    {
      "index": 93,
      "start": 247.886,
      "end": 248.4,
      "duration": 0.514,
      "text": "ERIC LANDER: Yeah."
    },
    {
      "index": 94,
      "start": 248.4,
      "end": 250.44,
      "duration": 2.04,
      "text": "The problem doing complementation is most human"
    },
    {
      "index": 95,
      "start": 250.44,
      "end": 251.66,
      "duration": 1.22,
      "text": "cells don't need beta globin."
    },
    {
      "index": 96,
      "start": 251.66,
      "end": 252.9,
      "duration": 1.24,
      "text": "What's beta globin good for?"
    },
    {
      "index": 97,
      "start": 252.9,
      "end": 255.375,
      "duration": 2.475,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 98,
      "start": 255.375,
      "end": 257.472,
      "duration": 2.097,
      "text": "ERIC LANDER: What's hemoglobin good for?"
    },
    {
      "index": 99,
      "start": 257.472,
      "end": 258.316,
      "duration": 0.844,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 100,
      "start": 258.316,
      "end": 260.79,
      "duration": 2.474,
      "text": "ERIC LANDER: It's in your red blood cells to transport"
    },
    {
      "index": 101,
      "start": 260.79,
      "end": 262.5,
      "duration": 1.71,
      "text": "oxygen around."
    },
    {
      "index": 102,
      "start": 262.5,
      "end": 264.94,
      "duration": 2.44,
      "text": "You think individual cells care?"
    },
    {
      "index": 103,
      "start": 264.94,
      "end": 266.84,
      "duration": 1.9,
      "text": "Nah."
    },
    {
      "index": 104,
      "start": 266.84,
      "end": 269.13,
      "duration": 2.29,
      "text": "Your marrow might, but only in C2."
    },
    {
      "index": 105,
      "start": 269.13,
      "end": 271.68,
      "duration": 2.55,
      "text": "The problem with doing it in a human cell initially is, if we"
    },
    {
      "index": 106,
      "start": 271.68,
      "end": 273.92,
      "duration": 2.24,
      "text": "tried the same exact trick and we tried a beta"
    },
    {
      "index": 107,
      "start": 273.92,
      "end": 276.58,
      "duration": 2.66,
      "text": "globin-deficient human cell, and we're going to try to"
    },
    {
      "index": 108,
      "start": 276.58,
      "end": 279.81,
      "duration": 3.23,
      "text": "complement with a beta globin, the problem is we don't have"
    },
    {
      "index": 109,
      "start": 279.81,
      "end": 283.48,
      "duration": 3.67,
      "text": "any conditions under which that cell cares."
    },
    {
      "index": 110,
      "start": 283.48,
      "end": 285.23,
      "duration": 1.75,
      "text": "But we'll come back and even do more because we could do"
    },
    {
      "index": 111,
      "start": 285.23,
      "end": 285.96,
      "duration": 0.73,
      "text": "things here."
    },
    {
      "index": 112,
      "start": 285.96,
      "end": 286.97,
      "duration": 1.01,
      "text": "So now what are we going to do?"
    },
    {
      "index": 113,
      "start": 286.97,
      "end": 288.95,
      "duration": 1.98,
      "text": "How are we going to see where our beta globin is?"
    },
    {
      "index": 114,
      "start": 288.95,
      "end": 290.7,
      "duration": 1.75,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 115,
      "start": 290.7,
      "end": 293.8,
      "duration": 3.1,
      "text": "ERIC LANDER: Make the protein."
    },
    {
      "index": 116,
      "start": 293.8,
      "end": 295.1,
      "duration": 1.3,
      "text": "So we're going to persuade this E."
    },
    {
      "index": 117,
      "start": 295.1,
      "end": 296.57,
      "duration": 1.47,
      "text": "coli to make the protein."
    },
    {
      "index": 118,
      "start": 296.57,
      "end": 298.271,
      "duration": 1.701,
      "text": "And how are we going to recognize the protein?"
    },
    {
      "index": 119,
      "start": 298.271,
      "end": 299.955,
      "duration": 1.684,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 120,
      "start": 299.955,
      "end": 303.43,
      "duration": 3.475,
      "text": "ERIC LANDER: So how can we recognize a protein?"
    },
    {
      "index": 121,
      "start": 303.43,
      "end": 305.705,
      "duration": 2.275,
      "text": "AUDIENCE: Function."
    },
    {
      "index": 122,
      "start": 305.705,
      "end": 306.59,
      "duration": 0.885,
      "text": "ERIC LANDER: Sorry?"
    },
    {
      "index": 123,
      "start": 306.59,
      "end": 307.536,
      "duration": 0.946,
      "text": "AUDIENCE: Function."
    },
    {
      "index": 124,
      "start": 307.536,
      "end": 309.12,
      "duration": 1.584,
      "text": "ERIC LANDER: Function."
    },
    {
      "index": 125,
      "start": 309.12,
      "end": 310.88,
      "duration": 1.76,
      "text": "The problem is we didn't really have a function to"
    },
    {
      "index": 126,
      "start": 310.88,
      "end": 312.13,
      "duration": 1.25,
      "text": "complement."
    },
    {
      "index": 127,
      "start": 314.02,
      "end": 315.49,
      "duration": 1.47,
      "text": "Electrophoresis."
    },
    {
      "index": 128,
      "start": 315.49,
      "end": 320.11,
      "duration": 4.62,
      "text": "We could actually take every colony on the plate, grow it"
    },
    {
      "index": 129,
      "start": 320.11,
      "end": 324.76,
      "duration": 4.65,
      "text": "up, purify the proteins, and see if there was a protein"
    },
    {
      "index": 130,
      "start": 324.76,
      "end": 328.41,
      "duration": 3.65,
      "text": "band at just the right place for beta globin."
    },
    {
      "index": 131,
      "start": 328.41,
      "end": 331.59,
      "duration": 3.18,
      "text": "We'd have to look at about a million colonies to do it."
    },
    {
      "index": 132,
      "start": 331.59,
      "end": 333.55,
      "duration": 1.96,
      "text": "Maybe a little more, actually more because you know,"
    },
    {
      "index": 133,
      "start": 333.55,
      "end": 335.71,
      "duration": 2.16,
      "text": "statistics and all, 10 million colonies."
    },
    {
      "index": 134,
      "start": 335.71,
      "end": 338.64,
      "duration": 2.93,
      "text": "And the issue there is graduate students tend to, you"
    },
    {
      "index": 135,
      "start": 338.64,
      "end": 341.48,
      "duration": 2.84,
      "text": "can check with the TAs, but on the whole, tend to rebel at"
    },
    {
      "index": 136,
      "start": 341.48,
      "end": 347.53,
      "duration": 6.05,
      "text": "the thought of prepping protein from 10 million"
    },
    {
      "index": 137,
      "start": 347.53,
      "end": 349.03,
      "duration": 1.5,
      "text": "separate cells."
    },
    {
      "index": 138,
      "start": 349.03,
      "end": 351.78,
      "duration": 2.75,
      "text": "How else can we tell if our cells are making beta globin?"
    },
    {
      "index": 139,
      "start": 354.72,
      "end": 356.68,
      "duration": 1.96,
      "text": "AUDIENCE: You add a marker to it?"
    },
    {
      "index": 140,
      "start": 356.68,
      "end": 359.85,
      "duration": 3.17,
      "text": "ERIC LANDER: Something that sticks to beta globin."
    },
    {
      "index": 141,
      "start": 359.85,
      "end": 363.48,
      "duration": 3.63,
      "text": "Turns out that antibodies are really good for this."
    },
    {
      "index": 142,
      "start": 363.48,
      "end": 366.59,
      "duration": 3.11,
      "text": "If you take beta globin and you inject a mouse with beta"
    },
    {
      "index": 143,
      "start": 366.59,
      "end": 368.835,
      "duration": 2.245,
      "text": "globin, it'll make an immune reaction against it."
    },
    {
      "index": 144,
      "start": 368.835,
      "end": 370.96,
      "duration": 2.125,
      "text": "And we'll learn more about the immune system in the course,"
    },
    {
      "index": 145,
      "start": 370.96,
      "end": 372.84,
      "duration": 1.88,
      "text": "but it will actually make antibodies that"
    },
    {
      "index": 146,
      "start": 372.84,
      "end": 374.54,
      "duration": 1.7,
      "text": "bind to beta globin."
    },
    {
      "index": 147,
      "start": 374.54,
      "end": 377.03,
      "duration": 2.49,
      "text": "So suppose I told you there were antibodies that actually"
    },
    {
      "index": 148,
      "start": 377.03,
      "end": 378.28,
      "duration": 1.25,
      "text": "bind to beta globin?"
    },
    {
      "index": 149,
      "start": 381.94,
      "end": 382.9,
      "duration": 0.96,
      "text": "Now, what can I do?"
    },
    {
      "index": 150,
      "start": 382.9,
      "end": 384.235,
      "duration": 1.335,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 151,
      "start": 384.235,
      "end": 386.55,
      "duration": 2.315,
      "text": "ERIC LANDER: I'll make it a fluorescent antibody, sure."
    },
    {
      "index": 152,
      "start": 386.55,
      "end": 388.78,
      "duration": 2.23,
      "text": "You can have a fluorescent antibody if you want."
    },
    {
      "index": 153,
      "start": 388.78,
      "end": 390.32,
      "duration": 1.54,
      "text": "Fluorescent antibody that knows how to"
    },
    {
      "index": 154,
      "start": 390.32,
      "end": 391.78,
      "duration": 1.46,
      "text": "bind to beta globin."
    },
    {
      "index": 155,
      "start": 391.78,
      "end": 393.94,
      "duration": 2.16,
      "text": "Now, how do I find my cell?"
    },
    {
      "index": 156,
      "start": 393.94,
      "end": 395.66,
      "duration": 1.72,
      "text": "AUDIENCE: Colonies."
    },
    {
      "index": 157,
      "start": 395.66,
      "end": 396.9,
      "duration": 1.24,
      "text": "ERIC LANDER: Take my colonies."
    },
    {
      "index": 158,
      "start": 396.9,
      "end": 397.41,
      "duration": 0.51,
      "text": "Do what to them?"
    },
    {
      "index": 159,
      "start": 397.41,
      "end": 398.874,
      "duration": 1.464,
      "text": "AUDIENCE: Add antibodies."
    },
    {
      "index": 160,
      "start": 398.874,
      "end": 401.314,
      "duration": 2.44,
      "text": "And look for the colony that had antibodies--"
    },
    {
      "index": 161,
      "start": 401.314,
      "end": 402.63,
      "duration": 1.316,
      "text": "ERIC LANDER: Stuck to it."
    },
    {
      "index": 162,
      "start": 402.63,
      "end": 404.78,
      "duration": 2.15,
      "text": "I just wash antibodies over my colonies and"
    },
    {
      "index": 163,
      "start": 404.78,
      "end": 406.47,
      "duration": 1.69,
      "text": "see where it sticks."
    },
    {
      "index": 164,
      "start": 406.47,
      "end": 409.81,
      "duration": 3.34,
      "text": "Now, the only details are this is on an agar plate, and it's"
    },
    {
      "index": 165,
      "start": 409.81,
      "end": 411.52,
      "duration": 1.71,
      "text": "really messy to do that."
    },
    {
      "index": 166,
      "start": 411.52,
      "end": 415.01,
      "duration": 3.49,
      "text": "So just technical details of pulling that off are I"
    },
    {
      "index": 167,
      "start": 415.01,
      "end": 417.97,
      "duration": 2.96,
      "text": "actually grew these on a little piece of filter paper."
    },
    {
      "index": 168,
      "start": 417.97,
      "end": 420.33,
      "duration": 2.36,
      "text": "So I put a piece of filter paper down."
    },
    {
      "index": 169,
      "start": 420.33,
      "end": 422.49,
      "duration": 2.16,
      "text": "I grow the colonies on filter paper getting their little"
    },
    {
      "index": 170,
      "start": 422.49,
      "end": 423.68,
      "duration": 1.19,
      "text": "nutrients through there."
    },
    {
      "index": 171,
      "start": 423.68,
      "end": 426.35,
      "duration": 2.67,
      "text": "I take off my piece of filter paper that has my colonies"
    },
    {
      "index": 172,
      "start": 426.35,
      "end": 427.49,
      "duration": 1.14,
      "text": "growing on it."
    },
    {
      "index": 173,
      "start": 427.49,
      "end": 430.78,
      "duration": 3.29,
      "text": "I need to crack open all of those cells, and it turns out"
    },
    {
      "index": 174,
      "start": 430.78,
      "end": 433.2,
      "duration": 2.42,
      "text": "I can do that by a chemical treatment that will crack open"
    },
    {
      "index": 175,
      "start": 433.2,
      "end": 435.48,
      "duration": 2.28,
      "text": "all the cells and leave their protein"
    },
    {
      "index": 176,
      "start": 435.48,
      "end": 436.96,
      "duration": 1.48,
      "text": "contents just spewed out."
    },
    {
      "index": 177,
      "start": 436.96,
      "end": 439.57,
      "duration": 2.61,
      "text": "They spew out their guts right here, each cell."
    },
    {
      "index": 178,
      "start": 443.09,
      "end": 446.19,
      "duration": 3.1,
      "text": "And then I wash my antibody over it, and my"
    },
    {
      "index": 179,
      "start": 446.19,
      "end": 450.55,
      "duration": 4.36,
      "text": "fluorescently-labeled antibody sticks to that guy telling me"
    },
    {
      "index": 180,
      "start": 450.55,
      "end": 453.09,
      "duration": 2.54,
      "text": "that beta globin was right there."
    },
    {
      "index": 181,
      "start": 453.09,
      "end": 454.34,
      "duration": 1.25,
      "text": "Any questions?"
    },
    {
      "index": 182,
      "start": 457.2,
      "end": 457.835,
      "duration": 0.635,
      "text": "I did it."
    },
    {
      "index": 183,
      "start": 457.835,
      "end": 459.085,
      "duration": 1.25,
      "text": "You did it."
    },
    {
      "index": 184,
      "start": 461.53,
      "end": 462.78,
      "duration": 1.25,
      "text": "Except there's a problem."
    },
    {
      "index": 185,
      "start": 465.39,
      "end": 466.568,
      "duration": 1.178,
      "text": "What was your problem?"
    },
    {
      "index": 186,
      "start": 466.568,
      "end": 469.774,
      "duration": 3.206,
      "text": "AUDIENCE: Is it possible that the antibody won't stick?"
    },
    {
      "index": 187,
      "start": 469.774,
      "end": 471.33,
      "duration": 1.556,
      "text": "ERIC LANDER: It's a wonderful antibody."
    },
    {
      "index": 188,
      "start": 471.33,
      "end": 472.665,
      "duration": 1.335,
      "text": "It's a perfectly specific antibody."
    },
    {
      "index": 189,
      "start": 472.665,
      "end": 474.23,
      "duration": 1.565,
      "text": "The antibody is totally perfect."
    },
    {
      "index": 190,
      "start": 474.23,
      "end": 477.48,
      "duration": 3.25,
      "text": "It only sticks to beta globin."
    },
    {
      "index": 191,
      "start": 477.48,
      "end": 479.01,
      "duration": 1.53,
      "text": "Does the bacteria want to make beta globin?"
    },
    {
      "index": 192,
      "start": 482.11,
      "end": 485.05,
      "duration": 2.94,
      "text": "You're throwing this stuff in and if any bacteria actually"
    },
    {
      "index": 193,
      "start": 485.05,
      "end": 488.21,
      "duration": 3.16,
      "text": "did make you beta globin, this would be working perfectly."
    },
    {
      "index": 194,
      "start": 488.21,
      "end": 491.8,
      "duration": 3.59,
      "text": "The little problem is, will a piece of human DNA thrown into"
    },
    {
      "index": 195,
      "start": 491.8,
      "end": 494.89,
      "duration": 3.09,
      "text": "E. coli make beta globin?"
    },
    {
      "index": 196,
      "start": 494.89,
      "end": 496.12,
      "duration": 1.23,
      "text": "No."
    },
    {
      "index": 197,
      "start": 496.12,
      "end": 497.28,
      "duration": 1.16,
      "text": "Why not?"
    },
    {
      "index": 198,
      "start": 497.28,
      "end": 499.22,
      "duration": 1.94,
      "text": "Well, let's go back to our understanding"
    },
    {
      "index": 199,
      "start": 499.22,
      "end": 500.47,
      "duration": 1.25,
      "text": "of how genes work."
    },
    {
      "index": 200,
      "start": 503.92,
      "end": 509.21,
      "duration": 5.29,
      "text": "The beta globin gene is a locus that has a human"
    },
    {
      "index": 201,
      "start": 509.21,
      "end": 516.94,
      "duration": 7.73,
      "text": "promoter which then goes and makes a transcript."
    },
    {
      "index": 202,
      "start": 516.94,
      "end": 521.809,
      "duration": 4.869,
      "text": "That transcript has multiple exons."
    },
    {
      "index": 203,
      "start": 521.809,
      "end": 525.66,
      "duration": 3.851,
      "text": "Those exons go into the transcript and are spliced"
    },
    {
      "index": 204,
      "start": 525.66,
      "end": 529.49,
      "duration": 3.83,
      "text": "together to make a mature message."
    },
    {
      "index": 205,
      "start": 529.49,
      "end": 532.83,
      "duration": 3.34,
      "text": "Here is the mature message, which gets translated."
    },
    {
      "index": 206,
      "start": 532.83,
      "end": 537.48,
      "duration": 4.65,
      "text": "We have splicing, and then this gets translated."
    },
    {
      "index": 207,
      "start": 537.48,
      "end": 540.07,
      "duration": 2.59,
      "text": "The spliced product gets translated."
    },
    {
      "index": 208,
      "start": 540.07,
      "end": 543.28,
      "duration": 3.21,
      "text": "And what's the problem asking E. coli to do this?"
    },
    {
      "index": 209,
      "start": 543.28,
      "end": 544.106,
      "duration": 0.826,
      "text": "AUDIENCE: It doesn't do splicing."
    },
    {
      "index": 210,
      "start": 544.106,
      "end": 547.01,
      "duration": 2.904,
      "text": "ERIC LANDER: It doesn't do splicing."
    },
    {
      "index": 211,
      "start": 547.01,
      "end": 550.07,
      "duration": 3.06,
      "text": "And in fact, if you told me we'll use yeast instead, it"
    },
    {
      "index": 212,
      "start": 550.07,
      "end": 553.39,
      "duration": 3.32,
      "text": "turns out yeast does a very bad job in splicing human"
    },
    {
      "index": 213,
      "start": 553.39,
      "end": 555.22,
      "duration": 1.83,
      "text": "introns also."
    },
    {
      "index": 214,
      "start": 555.22,
      "end": 557.405,
      "duration": 2.185,
      "text": "And E. coli doesn't recognize human promoters."
    },
    {
      "index": 215,
      "start": 560.49,
      "end": 561.74,
      "duration": 1.25,
      "text": "So this doesn't work very well."
    },
    {
      "index": 216,
      "start": 564.76,
      "end": 566.48,
      "duration": 1.72,
      "text": "Any takers on what we're going to do about this?"
    },
    {
      "index": 217,
      "start": 566.48,
      "end": 567.63,
      "duration": 1.15,
      "text": "How do we fix this problem?"
    },
    {
      "index": 218,
      "start": 567.63,
      "end": 570.31,
      "duration": 2.68,
      "text": "AUDIENCE: [INAUDIBLE]."
    },
    {
      "index": 219,
      "start": 570.31,
      "end": 572.35,
      "duration": 2.04,
      "text": "ERIC LANDER: Ah."
    },
    {
      "index": 220,
      "start": 572.35,
      "end": 576.42,
      "duration": 4.07,
      "text": "So one solution would be teach E. coli how to splice DNA."
    },
    {
      "index": 221,
      "start": 576.42,
      "end": 579.03,
      "duration": 2.61,
      "text": "That's hard."
    },
    {
      "index": 222,
      "start": 579.03,
      "end": 580.93,
      "duration": 1.9,
      "text": "Start with cDNA."
    },
    {
      "index": 223,
      "start": 580.93,
      "end": 581.87,
      "duration": 0.94,
      "text": "That's nice."
    },
    {
      "index": 224,
      "start": 581.87,
      "end": 589.3,
      "duration": 7.43,
      "text": "So let's take our messenger RNA, mRNA, and let's now"
    },
    {
      "index": 225,
      "start": 589.3,
      "end": 591.92,
      "duration": 2.62,
      "text": "convert it into cDNA."
    },
    {
      "index": 226,
      "start": 591.92,
      "end": 593.17,
      "duration": 1.25,
      "text": "What is cDNA?"
    },
    {
      "index": 227,
      "start": 595.32,
      "end": 599.92,
      "duration": 4.6,
      "text": "cDNA remember, we can copy RNA into DNA."
    },
    {
      "index": 228,
      "start": 599.92,
      "end": 602.34,
      "duration": 2.42,
      "text": "What enzyme copies RNA into DNA?"
    },
    {
      "index": 229,
      "start": 602.34,
      "end": 604.09,
      "duration": 1.75,
      "text": "We learned about it when we studied"
    },
    {
      "index": 230,
      "start": 604.09,
      "end": 605.39,
      "duration": 1.3,
      "text": "replication and all that."
    },
    {
      "index": 231,
      "start": 605.39,
      "end": 606.51,
      "duration": 1.12,
      "text": "AUDIENCE: Reverse transcriptase."
    },
    {
      "index": 232,
      "start": 606.51,
      "end": 608.75,
      "duration": 2.24,
      "text": "ERIC LANDER: Reverse transcriptase."
    },
    {
      "index": 233,
      "start": 608.75,
      "end": 612.55,
      "duration": 3.8,
      "text": "So if I can get my hands on some reverse transcriptase, I"
    },
    {
      "index": 234,
      "start": 612.55,
      "end": 616.41,
      "duration": 3.86,
      "text": "would be able to add reverse transcriptase to mRNAs from a"
    },
    {
      "index": 235,
      "start": 616.41,
      "end": 618.24,
      "duration": 1.83,
      "text": "human cell and make cDNA."
    },
    {
      "index": 236,
      "start": 618.24,
      "end": 620.6,
      "duration": 2.36,
      "text": "And where do I get reversed transcriptase?"
    },
    {
      "index": 237,
      "start": 620.6,
      "end": 621.98,
      "duration": 1.38,
      "text": "It's in the catalog."
    },
    {
      "index": 238,
      "start": 621.98,
      "end": 627.88,
      "duration": 5.9,
      "text": "So I now make cDNA and instead, I put"
    },
    {
      "index": 239,
      "start": 627.88,
      "end": 632.0,
      "duration": 4.12,
      "text": "the cDNA in the vector."
    },
    {
      "index": 240,
      "start": 632.0,
      "end": 633.38,
      "duration": 1.38,
      "text": "I do this, of course, for many, many,"
    },
    {
      "index": 241,
      "start": 633.38,
      "end": 634.6,
      "duration": 1.22,
      "text": "many different RNAs."
    },
    {
      "index": 242,
      "start": 634.6,
      "end": 637.9,
      "duration": 3.3,
      "text": "I take total RNA from the human cell, I convert all the"
    },
    {
      "index": 243,
      "start": 637.9,
      "end": 640.78,
      "duration": 2.88,
      "text": "total RNA all at once into different cDNAs."
    },
    {
      "index": 244,
      "start": 640.78,
      "end": 644.72,
      "duration": 3.94,
      "text": "Those different cDNAs get put into the vector, and I now"
    },
    {
      "index": 245,
      "start": 644.72,
      "end": 647.68,
      "duration": 2.96,
      "text": "have what's called a cDNA library."
    },
    {
      "index": 246,
      "start": 647.68,
      "end": 649.76,
      "duration": 2.08,
      "text": "So now I have a cDNA library."
    },
    {
      "index": 247,
      "start": 659.78,
      "end": 663.3,
      "duration": 3.52,
      "text": "And now each of these guys has not a piece of human genomic"
    },
    {
      "index": 248,
      "start": 663.3,
      "end": 669.11,
      "duration": 5.81,
      "text": "DNA, but a piece of human cDNA copied back from a message."
    },
    {
      "index": 249,
      "start": 669.11,
      "end": 671.43,
      "duration": 2.32,
      "text": "One of those guys has beta globin."
    },
    {
      "index": 250,
      "start": 671.43,
      "end": 673.24,
      "duration": 1.81,
      "text": "Now will E. coli produce beta globin?"
    },
    {
      "index": 251,
      "start": 675.85,
      "end": 676.28,
      "duration": 0.43,
      "text": "No."
    },
    {
      "index": 252,
      "start": 676.28,
      "end": 677.16,
      "duration": 0.88,
      "text": "Because"
    },
    {
      "index": 253,
      "start": 677.16,
      "end": 677.946,
      "duration": 0.786,
      "text": "AUDIENCE: Promoter."
    },
    {
      "index": 254,
      "start": 677.946,
      "end": 678.94,
      "duration": 0.994,
      "text": "ERIC LANDER: Promoter."
    },
    {
      "index": 255,
      "start": 678.94,
      "end": 682.0,
      "duration": 3.06,
      "text": "It doesn't have a promoter that it recognizes."
    },
    {
      "index": 256,
      "start": 682.0,
      "end": 682.945,
      "duration": 0.945,
      "text": "What are we going to do we do about that?"
    },
    {
      "index": 257,
      "start": 682.945,
      "end": 684.59,
      "duration": 1.645,
      "text": "AUDIENCE: Add one in the vector."
    },
    {
      "index": 258,
      "start": 684.59,
      "end": 685.54,
      "duration": 0.95,
      "text": "ERIC LANDER: Add one in the vector."
    },
    {
      "index": 259,
      "start": 685.54,
      "end": 687.045,
      "duration": 1.505,
      "text": "Give it a promoter in the vector."
    },
    {
      "index": 260,
      "start": 687.045,
      "end": 687.19,
      "duration": 0.145,
      "text": "Good."
    },
    {
      "index": 261,
      "start": 687.19,
      "end": 690.13,
      "duration": 2.94,
      "text": "You guys are getting into the engineering of this."
    },
    {
      "index": 262,
      "start": 690.13,
      "end": 693.755,
      "duration": 3.625,
      "text": "Let's say that the vector has an E. coli promoter."
    },
    {
      "index": 263,
      "start": 697.86,
      "end": 702.47,
      "duration": 4.61,
      "text": "Now, each of these cells will actually make that mRNA."
    },
    {
      "index": 264,
      "start": 702.47,
      "end": 706.74,
      "duration": 4.27,
      "text": "That mRNA is spliced, and it will, in"
    },
    {
      "index": 265,
      "start": 706.74,
      "end": 709.16,
      "duration": 2.42,
      "text": "fact, produce an mRNA."
    },
    {
      "index": 266,
      "start": 709.16,
      "end": 714.57,
      "duration": 5.41,
      "text": "The cell will translate it if we do this right, and is the"
    },
    {
      "index": 267,
      "start": 714.57,
      "end": 717.81,
      "duration": 3.24,
      "text": "genetic code the same in E. coli in human?"
    },
    {
      "index": 268,
      "start": 717.81,
      "end": 719.26,
      "duration": 1.45,
      "text": "Yup."
    },
    {
      "index": 269,
      "start": 719.26,
      "end": 724.03,
      "duration": 4.77,
      "text": "So we can actually make, you could make beta globin."
    },
    {
      "index": 270,
      "start": 724.03,
      "end": 729.07,
      "duration": 5.04,
      "text": "Now, we wash over our antibody, it recognizes which"
    },
    {
      "index": 271,
      "start": 729.07,
      "end": 732.8,
      "duration": 3.73,
      "text": "cell is making beta globin, and it sticks."
    },
    {
      "index": 272,
      "start": 732.8,
      "end": 735.11,
      "duration": 2.31,
      "text": "There's beta globin."
    },
    {
      "index": 273,
      "start": 735.11,
      "end": 737.466,
      "duration": 2.356,
      "text": "It works."
    },
    {
      "index": 274,
      "start": 737.466,
      "end": 740.14,
      "duration": 2.674,
      "text": "Oh, by the way, what have we also just invented here?"
    },
    {
      "index": 275,
      "start": 742.73,
      "end": 745.43,
      "duration": 2.7,
      "text": "We've invented a bacterial cell that's able to produce a"
    },
    {
      "index": 276,
      "start": 745.43,
      "end": 748.05,
      "duration": 2.62,
      "text": "human protein."
    },
    {
      "index": 277,
      "start": 748.05,
      "end": 749.79,
      "duration": 1.74,
      "text": "What if instead of beta globin, we put in"
    },
    {
      "index": 278,
      "start": 749.79,
      "end": 752.79,
      "duration": 3.0,
      "text": "the gene for insulin?"
    },
    {
      "index": 279,
      "start": 752.79,
      "end": 754.04,
      "duration": 1.25,
      "text": "What would we have invented?"
    },
    {
      "index": 280,
      "start": 756.6,
      "end": 760.37,
      "duration": 3.77,
      "text": "A way to produce insulin without having to purify it"
    },
    {
      "index": 281,
      "start": 760.37,
      "end": 764.8,
      "duration": 4.43,
      "text": "from the pancreases of animals, which is how we used"
    },
    {
      "index": 282,
      "start": 764.8,
      "end": 768.59,
      "duration": 3.79,
      "text": "to have to treat juvenile diabetics."
    },
    {
      "index": 283,
      "start": 768.59,
      "end": 773.13,
      "duration": 4.54,
      "text": "But instead, if we put the insulin gene in, and we have"
    },
    {
      "index": 284,
      "start": 773.13,
      "end": 776.0,
      "duration": 2.87,
      "text": "an E. coli promoter, let's say, in theory,"
    },
    {
      "index": 285,
      "start": 776.0,
      "end": 777.59,
      "duration": 1.59,
      "text": "we can make us insulin."
    },
    {
      "index": 286,
      "start": 777.59,
      "end": 780.05,
      "duration": 2.46,
      "text": "And what would we have invented?"
    },
    {
      "index": 287,
      "start": 780.05,
      "end": 782.57,
      "duration": 2.52,
      "text": "The biotechnology industry."
    },
    {
      "index": 288,
      "start": 782.57,
      "end": 785.11,
      "duration": 2.54,
      "text": "That's basically the start to the biotechnology industry."
    },
    {
      "index": 289,
      "start": 785.11,
      "end": 787.79,
      "duration": 2.68,
      "text": "One of the first things that was done was cloning the"
    },
    {
      "index": 290,
      "start": 787.79,
      "end": 792.33,
      "duration": 4.54,
      "text": "insulin gene to make recombinantly-produced insulin"
    },
    {
      "index": 291,
      "start": 792.33,
      "end": 795.04,
      "duration": 2.71,
      "text": "by just the method you guys invented today."
    },
    {
      "index": 292,
      "start": 795.04,
      "end": 797.33,
      "duration": 2.29,
      "text": "It's just unfortunately others invented them first, so you"
    },
    {
      "index": 293,
      "start": 797.33,
      "end": 799.93,
      "duration": 2.6,
      "text": "don't get a patent on it or anything, but all right."
    },
    {
      "index": 294,
      "start": 799.93,
      "end": 806.59,
      "duration": 6.66,
      "text": "So now we got two ways to clone genes so far, and there"
    },
    {
      "index": 295,
      "start": 806.59,
      "end": 807.95,
      "duration": 1.36,
      "text": "are a lot of ways to clone genes."
    },
    {
      "index": 296,
      "start": 807.95,
      "end": 809.77,
      "duration": 1.82,
      "text": "I've given you two, later in the course,"
    },
    {
      "index": 297,
      "start": 809.77,
      "end": 811.02,
      "duration": 1.25,
      "text": "I'll give you a third."
    }
  ],
