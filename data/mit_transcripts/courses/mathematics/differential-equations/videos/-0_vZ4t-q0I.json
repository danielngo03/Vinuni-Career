      "end": 448.6,
      "duration": 2.53,
      "text": "periodic with period 2 t.o"
    },
    {
      "index": 140,
      "start": 448.61,
      "end": 454.06,
      "duration": 5.45,
      "text": "right I i should also note that 5n is"
