      "text": "integration"
    },
    {
      "index": 80,
      "start": 203.52,
      "end": 209.75,
      "duration": 6.23,
      "text": "from 0 plus to infinity."
    },
    {
      "index": 81,
      "start": 212.59,
      "end": 212.6,
