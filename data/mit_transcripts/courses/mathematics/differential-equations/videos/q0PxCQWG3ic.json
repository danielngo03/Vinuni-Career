      "end": 181.83,
      "duration": 2.23,
      "text": "two. So, four"
    },
    {
      "index": 70,
      "start": 181.84,
      "end": 184.19,
      "duration": 2.35,
      "text": "sine two"
    },
    {
      "index": 71,
      "start": 184.2,
      "end": 186.59,
