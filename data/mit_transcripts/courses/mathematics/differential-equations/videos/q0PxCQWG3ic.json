      "text": "generalized derivative"
    },
    {
      "index": 100,
      "start": 255.44,
      "end": 257.71,
      "duration": 2.27,
      "text": "to f of t"
    },
    {
      "index": 101,
      "start": 257.72,
      "end": 261.229,
      "duration": 3.509,
      "text": "equals 3ut"
    },
