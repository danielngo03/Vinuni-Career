    {
      "index": 121,
      "start": 451.749,
      "end": 451.759,
      "duration": 0.01,
      "text": "response. Okay. So, what does this"
    },
    {
      "index": 122,
      "start": 451.759,
      "end": 454.27,
      "duration": 2.511,
      "text": "amplitude response look like for this"
