    {
      "index": 123,
      "start": 454.28,
      "end": 464.11,
      "duration": 9.83,
      "text": "case?"
    },
    {
      "index": 124,
      "start": 467.35,
      "end": 467.36,
      "duration": 0.01,
      "text": "Well, we have 1 over and it's the"
    },
    {
      "index": 125,
      "start": 467.36,
      "end": 469.11,
      "duration": 1.75,
      "text": "magnitude of this complex number which"
    },
    {
      "index": 126,
      "start": 469.12,
      "end": 473.51,
      "duration": 4.39,
      "text": "is 4 - omega^ 2 plus i omega."
    },
    {
      "index": 127,
      "start": 473.52,
      "end": 476.39,
      "duration": 2.87,
      "text": "So I just take the real part square it"
    },
    {
      "index": 128,
      "start": 476.4,
      "end": 479.27,
      "duration": 2.87,
      "text": "add it to the imaginary part squared and"
    },
    {
      "index": 129,
      "start": 479.28,
      "end": 482.909,
      "duration": 3.629,
      "text": "square root the whole"
    },
    {
      "index": 130,
      "start": 484.95,
      "end": 484.96,
      "duration": 0.01,
      "text": "quantity. Now there's a question of how"
    },
    {
      "index": 131,
      "start": 484.96,
      "end": 487.909,
      "duration": 2.949,
      "text": "to graph this and we see that it's that"
