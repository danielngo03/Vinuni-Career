      "end": 857.75,
      "duration": 1.15,
      "text": "wave function,"
    },
    {
      "index": 317,
      "start": 857.76,
      "end": 858.949,
      "duration": 1.189,
      "text": "we were able to compute their Fourier"
    },
    {
      "index": 318,
      "start": 858.959,
      "end": 860.75,
      "duration": 1.791,
      "text": "series. And we were able to do this"
    },
    {
      "index": 319,
      "start": 860.76,
      "end": 862.43,
      "duration": 1.67,
      "text": "essentially without having to evaluate"
