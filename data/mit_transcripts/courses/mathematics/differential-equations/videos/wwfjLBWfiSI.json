      "index": 96,
      "start": 333.59,
      "end": 333.6,
      "duration": 0.01,
      "text": "if not e to the i omega t"
    },
    {
      "index": 97,
      "start": 333.6,
      "end": 342.31,
      "duration": 8.71,
      "text": "/ e to the i fi"
