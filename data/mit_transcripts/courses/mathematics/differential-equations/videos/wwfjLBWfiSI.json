    {
      "index": 36,
      "start": 116.72,
      "end": 119.749,
      "duration": 3.029,
      "text": "/ p of i omega"
    },
    {
      "index": 37,
      "start": 119.759,
      "end": 122.55,
      "duration": 2.791,
      "text": "times the right hand side which is f e i"
    },
    {
      "index": 38,
      "start": 122.56,
      "end": 125.03,
      "duration": 2.47,
      "text": "omega t."
    },
    {
      "index": 39,
      "start": 125.04,
      "end": 127.109,
      "duration": 2.069,
      "text": "And in this case the characteristic"
    },
    {
      "index": 40,
      "start": 127.119,
      "end": 130.07,
      "duration": 2.951,
      "text": "polomial P of S is"
    },
    {
      "index": 41,
      "start": 130.08,
      "end": 133.19,
      "duration": 3.11,
      "text": "S ^2 + 8 S"
