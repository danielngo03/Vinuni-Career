      "index": 85,
      "start": 278.16,
      "end": 281.189,
      "duration": 3.029,
      "text": "response of the differential equation."
    },
    {
      "index": 86,
      "start": 281.199,
      "end": 283.59,
      "duration": 2.391,
      "text": "Now I'd like to go ahead and write x of"
