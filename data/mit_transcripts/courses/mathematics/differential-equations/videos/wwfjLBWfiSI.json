    },
    {
      "index": 70,
      "start": 212.799,
      "end": 220.789,
      "duration": 7.99,
      "text": "imaginary part. So specifically"
    },
    {
      "index": 71,
      "start": 222.309,
      "end": 222.319,
      "duration": 0.01,
      "text": "contains"
    },
    {
      "index": 72,
      "start": 222.319,
      "end": 225.99,
      "duration": 3.671,
      "text": "P of I omega contains"
