    {
      "index": 42,
      "start": 133.2,
      "end": 135.35,
      "duration": 2.15,
      "text": "+ 7."
    },
    {
      "index": 43,
      "start": 135.36,
      "end": 138.309,
      "duration": 2.949,
      "text": "So that P of I omega"
    },
    {
      "index": 44,
      "start": 138.319,
      "end": 142.71,
      "duration": 4.391,
      "text": "is going to be 7 - omega^ 2. So the"
    },
    {
      "index": 45,
      "start": 142.72,
      "end": 145.91,
      "duration": 3.19,
      "text": "omega^ 2 comes from S^2"
    },
    {
      "index": 46,
      "start": 145.92,
      "end": 150.15,
      "duration": 4.23,
      "text": "+ 8 I omega."
    },
    {
      "index": 47,
      "start": 150.16,
      "end": 152.07,
      "duration": 1.91,
      "text": "Now I'd just like to take a moment and"
    },
    {
      "index": 48,
      "start": 152.08,
      "end": 154.309,
      "duration": 2.229,
      "text": "step back for a second. If we take a"
    },
    {
      "index": 49,
      "start": 154.319,
      "end": 155.75,
      "duration": 1.431,
      "text": "look at the differential equation, the"
    },
    {
      "index": 50,
      "start": 155.76,
      "end": 158.949,
      "duration": 3.189,
      "text": "input on the right hand side is f e to"
    },
    {
      "index": 51,
      "start": 158.959,
      "end": 161.43,
      "duration": 2.471,
      "text": "the i omega t."
    },
    {
      "index": 52,
      "start": 161.44,
      "end": 163.91,
      "duration": 2.47,
      "text": "Now notice how this characteristic uh"
    },
    {
      "index": 53,
      "start": 163.92,
      "end": 165.509,
      "duration": 1.589,
      "text": "the sorry the exponential response"
    },
    {
      "index": 54,
      "start": 165.519,
      "end": 168.15,
      "duration": 2.631,
      "text": "formula gives us a particular solution"
    },
    {
      "index": 55,
      "start": 168.16,
      "end": 171.83,
      "duration": 3.67,
      "text": "which is 1 over p of i omega f e to the"
    },
    {
      "index": 56,
      "start": 171.84,
      "end": 176.55,
      "duration": 4.71,
      "text": "i omega t which is a periodic solution."
    },
    {
      "index": 57,
      "start": 176.56,
      "end": 180.63,
      "duration": 4.07,
      "text": "But moreover the output uh of this uh"
    },
    {
      "index": 58,
      "start": 180.64,
      "end": 183.91,
      "duration": 3.27,
      "text": "formula shows that uh it's actually the"
    },
    {
      "index": 59,
      "start": 183.92,
      "end": 186.39,
      "duration": 2.47,
      "text": "input forcing multiplied by this factor"
    },
    {
      "index": 60,
      "start": 186.4,
      "end": 189.27,
      "duration": 2.87,
      "text": "1 over p of i omega."
    },
    {
      "index": 61,
      "start": 189.28,
      "end": 193.03,
      "duration": 3.75,
      "text": "So this factor right here 1 over p of i"
    },
    {
      "index": 62,
      "start": 193.04,
      "end": 196.07,
      "duration": 3.03,
      "text": "omega relates the input forcing to the"
    },
    {
      "index": 63,
      "start": 196.08,
      "end": 198.229,
