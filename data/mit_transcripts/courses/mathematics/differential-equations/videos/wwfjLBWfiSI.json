    {
      "index": 31,
      "start": 99.84,
      "end": 102.31,
      "duration": 2.47,
      "text": "we're forcing it with an exponential. So"
    },
    {
      "index": 32,
      "start": 102.32,
      "end": 104.069,
      "duration": 1.749,
      "text": "we can just use the exponential response"
    },
    {
      "index": 33,
      "start": 104.079,
      "end": 110.389,
      "duration": 6.31,
      "text": "formula"
    },
    {
      "index": 34,
      "start": 113.749,
      "end": 113.759,
      "duration": 0.01,
      "text": "and this gives us a particular solution."
    },
    {
      "index": 35,
      "start": 113.759,
      "end": 116.71,
