      "duration": 12.31,
      "text": "be back in a minute."
    },
    {
      "index": 14,
      "start": 53.43,
      "end": 53.44,
      "duration": 0.01,
      "text": "Hi everyone, welcome back. Okay, so"
    },
    {
      "index": 15,
      "start": 53.44,
      "end": 54.549,
      "duration": 1.109,
      "text": "we're interested in finding this"
    },
    {
      "index": 16,
      "start": 54.559,
      "end": 56.229,
      "duration": 1.67,
      "text": "periodic solution to the differential"
    },
    {
      "index": 17,
      "start": 56.239,
      "end": 58.47,
      "duration": 2.231,
      "text": "equation. And we see here that we're"
    },
    {
      "index": 18,
      "start": 58.48,
      "end": 60.63,
      "duration": 2.15,
      "text": "forcing it with right hand side of"
    },
    {
      "index": 19,
      "start": 60.64,
      "end": 63.27,
      "duration": 2.63,
      "text": "cosine omega t. So the standard"
    },
