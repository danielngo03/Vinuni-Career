    {
      "index": 88,
      "start": 288.56,
      "end": 290.629,
      "duration": 2.069,
      "text": "t"
    },
    {
      "index": 89,
      "start": 290.639,
      "end": 292.629,
      "duration": 1.99,
      "text": "divided by"
    },
    {
      "index": 90,
      "start": 292.639,
      "end": 295.59,
      "duration": 2.951,
      "text": "the characteristic polomial evaluated at"
    },
    {
      "index": 91,
      "start": 295.6,
      "end": 297.99,
