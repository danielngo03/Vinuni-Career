NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-side API base. Use the relative `/api/v1` to go through the Next.js
# same-origin proxy (recommended; required for httpOnly refresh cookies in prod).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Backend origin (no /api/v1 suffix) used by the Next.js rewrite proxy and SSR
# fetches. In production point this at the backend Cloud Run URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_SUPPORTED_LOCALES=vi,en
NEXT_PUBLIC_BROWSER_LOCALE_DETECTION=true
